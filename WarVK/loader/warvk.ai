globals
    boolean WARVK_AI_LOADER_STARTED = false
endglobals

function WarVK_AiDebug takes string message returns nothing
    call DisplayTimedTextToPlayer(GetLocalPlayer(), 0.0, 0.0, 4.0, "[WarVK AI] " + message)
endfunction

function WarVK_AiRequestLuaLoader takes nothing returns nothing
    call Cheat("exec-lua:warvk_loader")
endfunction

function main takes nothing returns nothing
    if (WARVK_AI_LOADER_STARTED) then
        return
    endif

    set WARVK_AI_LOADER_STARTED = true
    call WarVK_AiDebug("request loader")
    call WarVK_AiRequestLuaLoader()
endfunction
