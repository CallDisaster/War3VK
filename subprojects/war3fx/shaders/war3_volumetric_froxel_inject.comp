#version 460

#extension GL_EXT_nonuniform_qualifier : require
#extension GL_EXT_scalar_block_layout : require

layout(local_size_x = 4, local_size_y = 4, local_size_z = 4) in;

layout(set = 0, binding = 0) uniform sampler s_samplers[];
layout(set = 1, binding = 0, rgba16f) writeonly uniform image3D s_current;
layout(set = 1, binding = 4) uniform textureCubeArray s_pointShadow;

layout(set = 1, binding = 2, scalar, row_major)
uniform CsmData {
  mat4 u_view;
  mat4 u_invViewProj;
  mat4 u_lightViewProj[4];
  vec4 u_splitFar;
  vec4 u_params;          // receiverBias, invShadowRes, cascadeCount, pcfRadius
  vec4 u_params2;         // blendRange, heightBase, heightFalloff, heightStrength
  vec4 u_sunDir;
  vec4 u_cameraPos;
  vec4 u_worldUp;
  vec4 u_volumeSunParams;
} csm;

struct PointLight {
  vec4 pos;
  vec4 color;
  vec4 shadow;
};

layout(set = 1, binding = 3, scalar)
uniform LightBlock {
  uint u_count;
  uint u_pointShadowSamplerIndex;
  uint u_pointShadowedLightCount;
  uint u_pad;
  vec4 u_pointShadowFilter;
  PointLight u_lights[16];
} lights;

struct FogVolume {
  vec4 worldToLocal0;
  vec4 worldToLocal1;
  vec4 worldToLocal2;
  vec4 params;
};

layout(set = 1, binding = 5, scalar)
uniform FogVolumeBlock {
  uint u_count;
  uint u_pad0;
  uint u_pad1;
  uint u_pad2;
  FogVolume u_volumes[8];
} fogVolumes;

layout(push_constant, scalar)
uniform push_block {
  uint p_samplePhase;
  uint p_flags;
  uint p_gridDepth;
  uint p_pad;
  vec4 p_grid;          // width, height, nearDistance, farDistance
  vec4 p_params0;       // intensity, albedo, globalDensity, contrastWeight
  // pointShadowStrength, coverage sample count, contrastWeight, reserved
  vec4 p_params1;
  vec4 p_sunColorScale; // ABI reserved; directional light integrates later
} pc;

bool finiteFloat(float v) {
  return !isnan(v) && !isinf(v);
}

bool finiteVec3(vec3 v) {
  return !any(isnan(v)) && !any(isinf(v));
}

bool finiteVec4(vec4 v) {
  return !any(isnan(v)) && !any(isinf(v));
}

float densityToSigmaT(float density) {
  float bounded = clamp(density, 0.0, 2.0);
  return (bounded / (1.0 + 0.5 * bounded)) * 0.0006;
}

vec3 fogWorldToLocalPoint(FogVolume volume, vec3 worldPos) {
  vec4 p = vec4(worldPos, 1.0);
  return vec3(dot(volume.worldToLocal0, p),
              dot(volume.worldToLocal1, p),
              dot(volume.worldToLocal2, p));
}

float fogVolumeWeight(FogVolume volume, vec3 localPos) {
  int shape = int(floor(volume.params.x + 0.5));
  float edge = 2.0;
  if (shape == 0)
    edge = length(localPos);
  else if (shape == 1)
    edge = max(max(abs(localPos.x), abs(localPos.y)), abs(localPos.z));
  else if (shape == 2)
    edge = max(length(localPos.xy), abs(localPos.z));
  if (!finiteFloat(edge) || edge >= 1.0)
    return 0.0;
  float feather = clamp(volume.params.z, 0.0, 1.0);
  return feather <= 1.0e-5
    ? 1.0
    : 1.0 - smoothstep(max(1.0 - feather, 0.0), 1.0, edge);
}

float sliceBoundary(float slice) {
  float intervalStart = max(pc.p_grid.z, 0.1);
  float intervalEnd = max(pc.p_grid.w, intervalStart + 1.0);
  float t = clamp(slice / float(pc.p_gridDepth), 0.0, 1.0);
  return intervalStart * exp(log(intervalEnd / intervalStart) * t);
}

bool reconstructFroxelSample(ivec3 cell, vec3 offset, out vec3 worldPos,
                             out vec3 cameraRay) {
  vec2 uv = (vec2(cell.xy) + vec2(0.5) + offset.xy) /
            max(pc.p_grid.xy, vec2(1.0));
  bool farIsOne = (pc.p_flags & 0x20u) != 0u;
  float farDepth = farIsOne ? 0.999 : 0.001;
  vec4 clip = vec4(uv.x * 2.0 - 1.0, 1.0 - uv.y * 2.0,
                   farDepth, 1.0);
  vec4 farWorldH = clip * csm.u_invViewProj;
  if (!finiteVec4(farWorldH) || abs(farWorldH.w) <= 1.0e-6)
    return false;
  vec3 farWorld = farWorldH.xyz / farWorldH.w;
  cameraRay = farWorld - csm.u_cameraPos.xyz;
  float rayLength = length(cameraRay);
  if (!finiteFloat(rayLength) || rayLength <= 1.0e-5)
    return false;
  cameraRay /= rayLength;
  float centerDistance = sliceBoundary(float(cell.z) + 0.5 + offset.z);
  worldPos = csm.u_cameraPos.xyz + cameraRay * centerDistance;
  return finiteVec3(worldPos);
}

float samplePointShadow(PointLight light, vec3 worldPos) {
  int layer = int(floor(light.shadow.x + 0.5));
  float shadowIntensity = clamp(light.shadow.y, 0.0, 1.0);
  if (lights.u_pointShadowedLightCount == 0u || layer < 0 || layer >= 4 ||
      shadowIntensity <= 1.0e-4)
    return 1.0;
  vec3 lightToCell = worldPos - light.pos.xyz;
  float distanceToLight = length(lightToCell);
  float range = max(light.pos.w, 1.0);
  if (!finiteFloat(distanceToLight) || distanceToLight <= 1.0e-5 ||
      distanceToLight >= range)
    return 1.0;
  vec3 direction = lightToCell / distanceToLight;
  float stored = texture(
    samplerCubeArray(s_pointShadow,
      s_samplers[nonuniformEXT(lights.u_pointShadowSamplerIndex)]),
    vec4(direction, float(layer))).r;
  if (!finiteFloat(stored))
    return 1.0;
  float current = distanceToLight / range;
  float majorAxis = max(max(abs(direction.x), abs(direction.y)), abs(direction.z));
  float texelWorld = 2.0 * majorAxis * max(lights.u_pointShadowFilter.x, 0.0) *
                     distanceToLight;
  float bias = clamp((max(lights.u_pointShadowFilter.y, 0.0) +
                      texelWorld * clamp(lights.u_pointShadowFilter.z, 0.0, 1.0)) /
                     range, 0.0, 0.01);
  float visible = current <= stored + bias ? 1.0 : 0.0;
  float rangeFade = 1.0 - smoothstep(
    clamp(lights.u_pointShadowFilter.w, 0.5, 0.98), 1.0, current);
  return mix(1.0, visible, shadowIntensity * rangeFade);
}

float hgPhaseNormalized(float mu, float g) {
  float gg = g * g;
  float denom = max(1.0 + gg - 2.0 * g * mu, 1.0e-3);
  float hg = (1.0 - gg) / (12.5663706 * pow(denom, 1.5));
  return hg / 0.07957747;
}

vec4 evaluateMedium(vec3 worldPos, vec3 cameraRay) {
  float sigmaT = densityToSigmaT(max(pc.p_params0.z, 0.0));
  if (csm.u_params2.w > 0.0 && sigmaT > 0.0) {
    vec3 up = normalize(csm.u_worldUp.xyz);
    float height = dot(worldPos, up);
    float heightDensity = 1.0 + csm.u_params2.w * exp(
      -max(csm.u_params2.z, 1.0e-5) * max(height - csm.u_params2.y, 0.0));
    sigmaT *= clamp(heightDensity, 0.0, 3.0);
  }

  uint volumeCount = min(fogVolumes.u_count, 8u);
  for (uint i = 0u; i < volumeCount; ++i) {
    FogVolume volume = fogVolumes.u_volumes[i];
    if (!finiteVec4(volume.worldToLocal0) ||
        !finiteVec4(volume.worldToLocal1) ||
        !finiteVec4(volume.worldToLocal2) || !finiteVec4(volume.params))
      continue;
    float weight = fogVolumeWeight(volume, fogWorldToLocalPoint(volume, worldPos));
    sigmaT += densityToSigmaT(max(volume.params.y, 0.0)) * weight;
  }

  sigmaT = clamp(sigmaT, 0.0, 0.01);
  if (!finiteFloat(sigmaT) || sigmaT <= 1.0e-8)
    return vec4(0.0);

  float albedo = clamp(pc.p_params0.y, 0.0, 0.999);
  float sigmaS = sigmaT * albedo;
  float intensity = max(pc.p_params0.x, 0.0);
  float shadowStrength = clamp(pc.p_params1.x, 0.0, 1.0);
  float contrast = clamp(pc.p_params1.z, 0.25, 3.0);
  vec3 source = vec3(0.0);

  uint pointCount = min(lights.u_count, 2u);
  for (uint i = 0u; i < pointCount; ++i) {
    PointLight light = lights.u_lights[i];
    vec3 toLight = light.pos.xyz - worldPos;
    float distanceToLight = length(toLight);
    float range = max(light.pos.w, 1.0);
    if (!finiteFloat(distanceToLight) || distanceToLight >= range)
      continue;
    float rangeWeight = 1.0 - distanceToLight / range;
    float attenuation = rangeWeight * rangeWeight;
    float rawVisibility = samplePointShadow(light, worldPos);
    float visibility = mix(1.0, pow(clamp(rawVisibility, 0.0, 1.0), contrast),
                           shadowStrength);
    source += max(light.color.rgb, vec3(0.0)) * max(light.color.w, 0.0) *
              attenuation * visibility;
  }

  source *= sigmaS * intensity;
  if (!finiteVec3(source))
    source = vec3(0.0);
  return vec4(max(source, vec3(0.0)), sigmaT);
}

void main() {
  ivec3 cell = ivec3(gl_GlobalInvocationID.xyz);
  ivec3 gridSize = ivec3(int(pc.p_grid.x + 0.5),
                         int(pc.p_grid.y + 0.5), int(pc.p_gridDepth));
  if (any(greaterThanEqual(cell, gridSize)))
    return;

  // The common radial grid makes world reprojection valid again. Rotate the
  // bounded spatial pattern every frame so temporal accumulation supplies
  // actual supersampling instead of averaging identical points.
  const vec3 coverageOffsets[4] = vec3[4](
    vec3(-0.25, -0.25, -0.288675),
    vec3( 0.25,  0.25,  0.288675),
    vec3( 0.25, -0.25,  0.288675),
    vec3(-0.25,  0.25, -0.288675));
  const vec3 phaseOffsets[8] = vec3[8](
    vec3(0.0000, 0.0000, 0.0000), vec3(0.5000, 0.3333, 0.1429),
    vec3(0.2500, 0.6667, 0.2857), vec3(0.7500, 0.1111, 0.4286),
    vec3(0.1250, 0.4444, 0.5714), vec3(0.6250, 0.7778, 0.7143),
    vec3(0.3750, 0.2222, 0.8571), vec3(0.8750, 0.5556, 0.0714));
  vec3 phase = phaseOffsets[int(pc.p_samplePhase & 7u)];
  int sampleCount = clamp(int(floor(pc.p_params1.y + 0.5)), 1, 4);
  vec4 medium = vec4(0.0);
  for (int sampleIndex = 0; sampleIndex < sampleCount; ++sampleIndex) {
    vec3 worldPos;
    vec3 cameraRay;
    vec3 offset = fract(coverageOffsets[sampleIndex] + phase + 0.5) - 0.5;
    if (reconstructFroxelSample(cell, offset,
                                worldPos, cameraRay))
      medium += evaluateMedium(worldPos, cameraRay);
  }
  medium /= float(sampleCount);
  imageStore(s_current, cell,
             finiteVec4(medium) ? max(medium, vec4(0.0)) : vec4(0.0));
}
